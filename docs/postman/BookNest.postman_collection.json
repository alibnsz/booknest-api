  "item": [
    {
      "name": "0. Health Check (GET /health)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Service status is ok', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Create Book — Valid (POST /api/v1/books)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Book returned with id and timestamps', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('id');",
              "  pm.expect(json.data.status).to.eql('available');",
              "  pm.expect(json.data.borrowedBy).to.eql(null);",
              "  pm.collectionVariables.set('bookId', json.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Crime and Punishment\",\n  \"author\": \"Fyodor Dostoevsky\",\n  \"category\": \"novel\",\n  \"year\": 1866\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"]
        }
      }
    },
    {
      "name": "2. Create Book — Missing Title (POST /api/v1/books)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Error code is VALIDATION_ERROR', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
